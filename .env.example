# Token for reading PRs from GitHub. Locally: GITHUB_TOKEN=$(gh auth token)
GITHUB_TOKEN=

# Whose PRs, in which repo
SOURCE_REPO=jaseci-labs/jac
PR_AUTHOR=akindu-k

# Any OpenAI-compatible chat completions endpoint. Defaults to Google's Gemini
# API; a free key comes from https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=

# Most explainers to write per run, and how much PR text to send per request
MAX_PER_RUN=10
MAX_INPUT_CHARS=120000
