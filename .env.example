# --- Website (npm start) ---

# The one account that can sign in. The server won't start without a password.
AUTH_USERNAME=akindu-k
AUTH_PASSWORD=

# Fine-grained token for this repo (Contents: read, Actions: read and write),
# used to read explainers and to start the explainer job from the Refresh button.
GITHUB_TOKEN=
# Read explainers from this repo; leave unset to read the local site/explainers.
CONTENT_REPO=

# --- Explainer job (npm run explain) ---

# Whose PRs, in which repo
SOURCE_REPO=jaseci-labs/jac
PR_AUTHOR=akindu-k

# claude-code: Claude subscription via the Claude Code CLI. Locally it uses your
# own login; in GitHub Actions set the CLAUDE_CODE_OAUTH_TOKEN secret.
LLM_PROVIDER=claude-code
LLM_MODEL=sonnet

# Or any OpenAI-compatible endpoint, for example Gemini's free tier:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.8-flash
# LLM_API_KEY=

# Most explainers to write per run, and how much PR text to send per request
MAX_PER_RUN=3
MAX_INPUT_CHARS=120000
